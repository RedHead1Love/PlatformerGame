  m_Script: {fileID: 11500000, guid: f4ebec4f4a4463a4a9924bbf9727f325, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _russianText: "[\u0444] \u2014 \u0412\u043B\u0435\u0432\u043E  \r\n[\u0432] \u2014
    \u0412\u043F\u0440\u0430\u0432\u043E \r\n[\u043F\u0440\u043E\u0431\u0435\u043B]
    \u2014 \u041F\u0440\u044B\u0436\u043E\u043A\r\n[\u044B] \u2014 \u0421\u0442\u043E\u044F
    \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435, \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F
    \u0432\u043D\u0438\u0437\r\n[\u043B\u0435\u0432\u044B\u0439 \u0428\u0438\u0444\u0442]
    \u2014 \u0420\u044B\u0432\u043E\u043A ( \u0421\u043B\u0430\u0439\u0434\u0435\u0440
    )\r\n\r\n[\u041B\u041A\u041C] \u2014 \u041E\u0431\u044B\u0447\u043D\u0430\u044F
    \u0430\u0442\u0430\u043A\u0430\r\n[\u041F\u041A\u041C] \u2014 \u0423\u0441\u0438\u043B\u0435\u043D\u043D\u0430\u044F
    \u0430\u0442\u0430\u043A\u0430\r\n\n[\u044D\u0441\u043A\u0435\u0439\u043F] \u2014
    \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E\r\n\r[\u0442\u0430\u0431]
    \u2014 \u041E\u0442\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0446\u0435\u043B\u044C
    \u0438\u0433\u0440\u044B\n\n[\u0430] \u2014 \u041E\u0442\u043A\u0440\u044B\u0442\u044C
    \u0441\u0443\u043D\u0434\u0443\u043A, \u0434\u0432\u0435\u0440\u044C, \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\r\n[\u044C]
    \u2014 \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
  _englishText: "[A] \u2014 Left  \r\n[D] \u2014 Right \r\n[Spacebar ] \u2014 Jump\r\n[S]
    \u2014 To fall through while standing on the platform\r\n[L. Shift] \u2014 Dash(Slider)\r\r\n\r\n[LKM]
    \u2014 Normal Attack\r\n[RKM] \u2014 Special Attack\r\n\n[ESC] \u2014 Pause Menu\r\n\r[TAB]
    \u2014 Track the game objective\n\n[A] \u2014 Open chest, door, trade\r\n[M]
    \u2014 Open map"
